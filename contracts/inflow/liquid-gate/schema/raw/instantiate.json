{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "type": "object",
  "required": [
    "admin",
    "hatom",
    "keeper",
    "operators",
    "profit_recipient",
    "settings",
    "vault"
  ],
  "properties": {
    "admin": {
      "type": "string"
    },
    "hatom": {
      "description": "The hATOM contract.",
      "type": "string"
    },
    "keeper": {
      "type": "string"
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profit_recipient": {
      "type": "string"
    },
    "settings": {
      "$ref": "#/definitions/Settings"
    },
    "vault": {
      "description": "The Inflow vault contract (deposit denom: hATOM).",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CurvePoint": {
      "description": "One point of a curve: the value `bps` (a discount or a bonus) at the buffer fill `f_bps`.",
      "type": "object",
      "required": [
        "bps",
        "f_bps"
      ],
      "properties": {
        "bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "f_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Settings": {
      "description": "The settings of SPEC §2, each checked against its bounds (`Settings::validate`).",
      "type": "object",
      "required": [
        "batch_interval_s",
        "batch_target_max_bps",
        "batch_target_min_bps",
        "book_horizon_s",
        "buffer_target",
        "burn_max_legs",
        "d_book_min_bps",
        "d_min_bps",
        "entry_curve",
        "exit_cap_tx",
        "exit_cap_window",
        "exit_curve",
        "inventory_cap",
        "max_entries",
        "max_slash_bps",
        "price_drift_bps_per_day",
        "price_jump_bps",
        "reset_tolerance_bps",
        "unbonding_time_s",
        "undelegate_max_validators",
        "unwind_max_fee_bps",
        "window_s"
      ],
      "properties": {
        "batch_interval_s": {
          "description": "Least time between two batches of the same validator.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "batch_target_max_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "batch_target_min_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "book_horizon_s": {
          "description": "`T` in the booking curve.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "buffer_target": {
          "description": "ATOM at which the buffer counts as full (`f = 1`).",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "burn_max_legs": {
          "description": "`max_legs` passed to hATOM's `Burn`, and the most legs a burn may have.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "d_book_min_bps": {
          "description": "Floor of the booking discount.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "d_min_bps": {
          "description": "Floor of the instant discount.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "entry_curve": {
          "description": "The swap entry bonus as a function of the buffer fill.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CurvePoint"
          }
        },
        "exit_cap_tx": {
          "description": "Largest exit, in ATOM value, per transaction.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "exit_cap_window": {
          "description": "Largest total exit value per window.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "exit_curve": {
          "description": "The instant discount as a function of the buffer fill.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CurvePoint"
          }
        },
        "inventory_cap": {
          "description": "Largest share inventory, in ATOM value.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "max_entries": {
          "description": "The chain's staking `max_entries`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_slash_bps": {
          "description": "Slash margin on batch capacity.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "price_drift_bps_per_day": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "price_jump_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reset_tolerance_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "unbonding_time_s": {
          "description": "The chain's `unbonding_time` (bounds and quotes only).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "undelegate_max_validators": {
          "description": "Most undelegations in one `ProcessBatch`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "unwind_max_fee_bps": {
          "description": "Largest imbalance fee an `Unwind`'s burn may pay, in bps of its value.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "window_s": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
