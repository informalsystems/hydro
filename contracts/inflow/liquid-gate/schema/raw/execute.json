          "minimum": 0.0
        },
        "d_min_bps": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "entry_curve": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/CurvePoint"
          }
