{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "ATOM in: mint hATOM and deposit it into the vault for `recipient`. `min_out` in shares.",
      "type": "object",
      "required": [
        "enter_direct"
      ],
      "properties": {
        "enter_direct": {
          "type": "object",
          "properties": {
            "min_out": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recipient": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "ATOM in: shares from the inventory, with the entry bonus. `min_out` in shares.",
      "type": "object",
      "required": [
        "enter_swap"
      ],
      "properties": {
        "enter_swap": {
          "type": "object",
          "properties": {
            "min_out": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recipient": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Shares in: ATOM now from the free buffer, less the exit discount. `min_out` in ATOM.",
      "type": "object",
      "required": [
        "exit_instant"
      ],
      "properties": {
        "exit_instant": {
          "type": "object",
          "properties": {
            "min_out": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recipient": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Shares in: ATOM owed at the maturity of batch `batch_id`. `min_out` in ATOM.",
      "type": "object",
      "required": [
        "book_exit"
      ],
      "properties": {
        "book_exit": {
          "type": "object",
          "required": [
            "batch_id"
          ],
          "properties": {
            "batch_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "min_out": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recipient": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Anyone: pays the listed bookings of matured batches to their owners. Ids of batches not matured yet (`not_matured`) and unknown or already claimed ids (`not_found`) are skipped.",
      "type": "object",
      "required": [
        "claim_bookings"
      ],
      "properties": {
        "claim_bookings": {
          "type": "object",
          "required": [
            "booking_ids"
          ],
          "properties": {
            "booking_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Withdraw shares from the vault, burn the hATOM, redeem the LSM shares.",
      "type": "object",
      "required": [
        "unwind"
      ],
      "properties": {
        "unwind": {
          "type": "object",
          "properties": {
            "shares": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Undelegate the gate's delegations into a new batch.",
      "type": "object",
      "required": [
        "process_batch"
      ],
      "properties": {
        "process_batch": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "update_config"
      ],
      "properties": {
        "update_config": {
          "type": "object",
          "required": [
            "settings"
          ],
          "properties": {
            "settings": {
              "$ref": "#/definitions/SettingsUpdate"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "set_operators"
      ],
      "properties": {
        "set_operators": {
          "type": "object",
          "required": [
            "operators"
          ],
          "properties": {
            "operators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "set_keeper"
      ],
      "properties": {
        "set_keeper": {
          "type": "object",
          "required": [
            "keeper"
          ],
          "properties": {
            "keeper": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "transfer_admin"
      ],
      "properties": {
        "transfer_admin": {
          "type": "object",
          "required": [
            "admin"
          ],
          "properties": {
            "admin": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "accept_admin"
      ],
      "properties": {
        "accept_admin": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Operator or admin: refuses `EnterSwap`, `EnterDirect`, `ExitInstant`, `BookExit`, `Unwind` and `ProcessBatch`. Never `ClaimBookings`: a pause never blocks what users are owed.",
      "type": "object",
      "required": [
        "pause"
      ],
      "properties": {
        "pause": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin only.",
      "type": "object",
      "required": [
        "unpause"
      ],
      "properties": {
        "unpause": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin or operator: `price` is the share price (ATOM per 10^6 share units) they verified.",
      "type": "object",
      "required": [
        "reset_price_reference"
      ],
      "properties": {
        "reset_price_reference": {
          "type": "object",
          "required": [
            "price"
          ],
          "properties": {
            "price": {
              "$ref": "#/definitions/Uint128"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Keeper or admin: the shares to unwind per interval.",
      "type": "object",
      "required": [
        "set_batch_target"
      ],
      "properties": {
        "set_batch_target": {
          "type": "object",
          "required": [
            "shares"
          ],
          "properties": {
            "shares": {
              "$ref": "#/definitions/Uint128"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: ATOM from the free buffer and shares from the inventory, to `profit_recipient`. Shares are checked only against the inventory and leave at their average cost basis, whatever their value: withdrawing them below cost is allowed on purpose (it is Hydro's own inventory).",
      "type": "object",
      "required": [
        "withdraw_profit"
      ],
      "properties": {
        "withdraw_profit": {
          "type": "object",
          "properties": {
            "atom": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "shares": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: a stray balance to `profit_recipient`.",
      "type": "object",
      "required": [
        "sweep"
      ],
      "properties": {
        "sweep": {
          "type": "object",
          "required": [
            "denom"
          ],
          "properties": {
            "denom": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Internal: the final self-call of every operation that changes balances (SPEC §9). Only the contract itself may call it (`Unauthorized` otherwise).",
      "type": "object",
      "required": [
        "assert_invariants"
      ],
      "properties": {
        "assert_invariants": {
          "type": "object",
          "properties": {
            "swap": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SwapCheck"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "CurvePoint": {
      "description": "One point of a curve: the value `bps` (a discount or a bonus) at the buffer fill `f_bps`.",
      "type": "object",
      "required": [
        "bps",
        "f_bps"
      ],
      "properties": {
        "bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "f_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "SettingsUpdate": {
      "description": "`UpdateConfig`: every field optional; the result is checked as a whole.",
      "type": "object",
      "properties": {
        "batch_interval_s": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "batch_target_max_bps": {
