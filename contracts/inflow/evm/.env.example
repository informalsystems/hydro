# Copy this file to .env.<target> (for example .env.staging, .env.production) and fill
# it in, or to plain .env for the default target. Every bin/ script reads exactly one
# of these files, selected with --env, so environments cannot leak into one another.
#
# All .env* files except this one are gitignored. Never commit a filled-in copy.

# ── Network ──────────────────────────────────────────────────────────────────

RPC_URL=
# Chain the scripts are allowed to touch. Every script aborts if the RPC reports a
# different id, which is what stops a staging run from reaching production.
# Find it with: cast chain-id --rpc-url $RPC_URL
EXPECTED_CHAIN_ID=

# Block explorer key, used by bin/01 (--verify) and bin/06. One key works across chains.
# ETHERSCAN_API_KEY=

# ── Signing (set exactly one) ────────────────────────────────────────────────

# PRIVATE_KEY=0x...
# MNEMONIC="word1 word2 ... word24"
# ACCOUNT_NAME=            # foundry keystore account, see `cast wallet import`

# ── Safes ────────────────────────────────────────────────────────────────────
# Two independent roles, deliberately held by different Safes: the one that moves
# funds cannot also restate what the vault is worth. See "Role split" in the README.

# In the vault whitelist. Admin ops, adapter wiring, and fund movement.
ADMIN_SAFE=
# In the deployed-amount whitelist. submitDeployedAmount and nothing else.
SUBMIT_SAFE=

# ── Vault deployment (bin/01) ────────────────────────────────────────────────

ASSET=                              # ERC-20 accepted as deposit
VAULT_NAME=
VAULT_SYMBOL=
DEPOSIT_CAP=                        # max total assets, in the asset's base units
MAX_WITHDRAWALS_PER_USER=10
INITIAL_ADMIN=${ADMIN_SAFE}
INITIAL_DEPLOYED_AMOUNT_ADMIN=${SUBMIT_SAFE}
FEE_RATE=0                          # WAD; 0 disables fees, 1e17 is 10%
# FEE_RECIPIENT=                    # required when FEE_RATE > 0

# ── Reserve adapter (bin/02, bin/03, bin/04) ─────────────────────────────────

VAULT_ADDRESS=                      # proxy address printed by bin/01

# How the vault/adapter handshake is performed:
#   safe     deploy only, then execute the batch from bin/04 in the admin Safe.
#            Required wherever the vault whitelist holds only the Safe.
#   deployer deploy and wire in one broadcast. Needs a vault-whitelisted deployer EOA.
WIRE_MODE=safe

# ADAPTER_ADMIN=                    # defaults to ADMIN_SAFE, or the deployer in deployer mode
# ADAPTER_NAME=reserve              # vault-side name for the reserve adapter
# ADAPTER_ADDRESS=                  # proxy address printed by bin/02; reported by bin/05

# ── Flow testing and seeding (bin/05) ────────────────────────────────────────

# DEPOSIT_AMOUNT=1000000            # base units; 1_000_000 is 1 USDC at 6 decimals
# SKIP_REDEEM=false                 # true keeps the shares, which seeds the vault
# EXPECTED_DEPLOYER=                # if set, bin/05 refuses to run from any other account

# ── Explorer verification (bin/06) ───────────────────────────────────────────

# VERIFY_ADAPTER_LIB=
# VERIFY_WITHDRAWAL_LIB=
# VERIFY_IMPL=
# VERIFY_PROXY=
# VERIFY_INIT_DATA=                 # initialize() calldata passed to the proxy constructor
